    "doc_id": "sql_hard_eval_01_init",
    "text": "import sqlite3 def record_journal_entry(db_path, debit_account, credit_account, amount): conn = sqlite3.connect(db_path, timeout=5.0) cur = conn.cursor() # Bug: Starts with default deferred transaction; updates accounts in caller order, causing deadlock cur.execute(\"BEGIN;\") cur.execute(\"UPDATE balances SET amount = amount - ? WHERE acc_id = ?\", (amount, debit_account)) cur.execute(\"UPDATE balances SET amount = amount + ? WHERE acc_id = ?\", (amount, credit_account)) conn.commit() conn.close()",
