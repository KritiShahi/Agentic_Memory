{
  "provider": "particle_ai",
  "model": "glm-5.3-flash",
  "endpoint_url": "https://api.particle.ai/v1/chat/completions",
  "pinned_parameters": {
    "temperature": 0.0,
    "top_p": 1.0,
    "max_tokens": 4096,
    "seed": 42,
    "reasoning_effort": "none"
  },
  "evaluation_seed": 42,
  "max_budget_usd": 1.00,
  "expected_budget_usd": 0.27,
  "token_pricing": {
    "input_cost_per_1m_tokens": 0.10,
    "output_cost_per_1m_tokens": 0.10,
    "cached_input_cost_per_1m_tokens": 0.05
  },
  "context_window_budget": {
    "fixed_memory_budget_tokens": 1000,
    "max_completion_tokens": 4096
  },
  "anti_leakage": {
    "enforce_disjoint_repos": true,
    "enforce_org_clustering": true,
    "enforce_deduplicated_eval_instances": true,
    "filter_pretraining_memorized_repos": true
  }
}
